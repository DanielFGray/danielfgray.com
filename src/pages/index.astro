---
import '../styles/global.css'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Daniel F. Gray</title>
    <meta
      name="description"
      content="Daniel F. Gray — musician, music teacher, and software developer."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="name-bridge">
      <h1>Daniel F. Gray</h1>
    </div>
    <main class="split">
      <section class="half music">
        <p class="tagline">I teach music</p>
        <p class="bio">
          Private instruction in drums, guitar, bass, and piano. All ages and skill levels welcome.
        </p>
        <a class="cta" href="https://dfg.rocks">dfg.rocks</a>
      </section>
      <section class="half code">
        <p class="tagline">I write code</p>
        <p class="bio">
          Full-stack developer. TypeScript, React, Node, PostgreSQL, and Linux.
        </p>
        <a class="cta" href="https://dfg.codes">dfg.codes</a>
      </section>
    </main>
  </body>
</html>
